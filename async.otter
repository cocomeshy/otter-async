use memory;
use thread;

/**
 * Async runtime (thread-backed).
 *
 * The compiler lowers a call to an `async` function into:
 *   1. a heap task block  { done:i64, result:i64, args... }
 *   2. `spawn(thunk_ptr, task_ptr)` - run the fn on a worker thread
 * and lowers `await h` into `poll(h)`.
 *
 * v1 model: one OS thread per async call; `poll` blocks until the worker
 * sets the done flag, then joins. Await a handle exactly once.
 */

/**
 * Launches the task thunk on a worker thread.
 * Returns an opaque handle (a control block: { task_ptr, thread_handle }).
 * @param thunk  Compiler-generated worker entry (__otter_async_thunk_*)
 * @param task   Heap task block carrying args + result + done flag
 */
~> spawn(thunk:rawptr, task:rawptr) -> int {
  rock ctl:rawptr = memory.alloc(16);
  *ctl = (int)task;
  rock th:rawptr = thread.spawn(thunk, task);
  rock th_slot:rawptr = ctl @ 8;
  *th_slot = (int)th;
  return (int)ctl;
}

/**
 * Blocks until the awaited task completes, reclaims the worker thread and
 * control block, and returns the TASK BLOCK address as an int. The compiler's
 * `await` lowering reads the raw result slot (task@8) itself - the slot can
 * hold a tagged bignum, which must not round-trip through a rawptr load -
 * and frees the task block afterwards.
 * @param handle  Handle returned by spawn()
 * @returns       Address of the completed task block
 */
~> poll(handle:int) -> int {
  rock ctl:rawptr = (rawptr)handle;
  rock task:rawptr = (rawptr)*ctl;
  rock th_slot:rawptr = ctl @ 8;
  rock th:rawptr = (rawptr)*th_slot;

  // Adaptive wait on the done flag (task@0): spin with cpu-pause hints for
  // short tasks (sub-microsecond wakeup), then back off through nanosleeps
  // capped at 1ms. Short awaits no longer pay a 1ms latency floor and long
  // awaits no longer fire syscalls every millisecond.
  flow spins:int = 0;
  flow napms:int = 0;
  flow waiting:bool = true;
  loop (waiting) {
    rock done:int = __otter_atomic_load64(task);
    match (done == 1) {
      true -> { waiting = false; };
      _ -> {
        match (spins < 2000) {
          true -> { __otter_cpu_pause(); spins += 1; };
          _ -> {
            match (napms < 1) { true -> { napms = 1; }; _ -> {}; }
            thread.sleep(napms);
            match (napms < 8) { true -> { napms = napms * 2; }; _ -> {}; }
          };
        }
      };
    }
  }

  thread.join(th);
  memory.free(ctl);
  return (int)task;
}
